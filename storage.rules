rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function role() {
      return request.auth != null
        ? firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.role
        : null;
    }

    match /videos/{fileName} {
      allow read: if role() in ['admin', 'viewer'];
      allow create, update: if role() == 'admin'
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType == 'video/mp4';
      allow delete: if role() == 'admin';
    }

    match /images/{fileName} {
      allow read: if role() in ['admin', 'viewer'];
      allow create, update: if role() == 'admin'
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');
      allow delete: if role() == 'admin';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
